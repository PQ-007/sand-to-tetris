// Bitfall: an original falling-block game (docs/GAME.md), in C Shard, on
// the OS. Arrows move and rotate, down drops one row, space drops at once.

const W = 10;
const H = 20;
const FULL = 1023;          // a full row: ten 1 bits
const BOARD_X = 44;         // the board's top-left pixel
const BOARD_Y = 8;
const LEFT = 128;
const UP = 129;
const RIGHT = 130;
const DOWN = 131;

var board: [int; 20];       // each row a 10-bit number, the leftmost cell in bit 9
var piece: [int; 5];        // the falling piece: 5-bit rows, the leftmost cell in bit 4
var next: [int; 5];         // the one after it
var spare: [int; 5];        // scratch for rotating
var turned: [int; 5];       // scratch for rotating
var px = 0;                 // the piece's column (of its bit 4) and row (of its row 0)
var py = 0;
var score = 0;
var lines = 0;
var level = 1;
var target = 0;
var over = false;

// ---- pieces ------------------------------------------------------------------

// The lowest nonzero row + 1.
fn height(p: [int]) -> int {
    var h = 0;
    for r in 0..5 {
        if p[r] != 0 { h = r + 1; }
    }
    return h;
}

// Columns used, counted from the left (the piece is moved to bit 4).
fn width(p: [int]) -> int {
    var all = 0;
    for r in 0..5 { all = all | p[r]; }
    var w = 0;
    while all != 0 {
        w = w + 1;
        all = (all << 1) & 31;
    }
    return w;
}

// Move a piece to the top-left of its 5 x 5 square.
fn normalize(p: [int]) {
    var all = 0;
    for r in 0..5 { all = all | p[r]; }
    if all == 0 { return; }
    while p[0] == 0 {
        for k in 0..4 { p[k] = p[k + 1]; }
        p[4] = 0;
    }
    while all & 16 == 0 {
        for j in 0..5 { p[j] = (p[j] << 1) & 31; }
        all = (all << 1) & 31;
    }
}

// Is cell (row r, column c) of the 5 x 5 square filled?
fn has(p: [int], r: int, c: int) -> bool {
    return (p[r] >> (4 - c)) & 1 == 1;
}

// A new piece: one cell, then neighbours at random until it has 3 to 5.
fn grow(p: [int]) {
    for r in 0..5 { p[r] = 0; }
    p[2] = 4;                       // the middle cell
    var want = 3 + random_below(3);
    var count = 1;
    while count < want {
        var row = random_below(5);
        var col = random_below(5);
        if has(p, row, col) {
            var nr = row;
            var nc = col;
            var dir = random_below(4);
            if dir == 0 { nr = row - 1; }
            else if dir == 1 { nr = row + 1; }
            else if dir == 2 { nc = col - 1; }
            else { nc = col + 1; }
            if nr >= 0 and nr < 5 and nc >= 0 and nc < 5 and not has(p, nr, nc) {
                p[nr] = p[nr] | (1 << (4 - nc));
                count = count + 1;
            }
        }
    }
    normalize(p);
}

// Turn a piece a quarter clockwise: (row y, column x) -> (row x, column h - 1 - y).
fn rotate(p: [int]) {
    var h = height(p);
    for r in 0..5 { turned[r] = 0; }
    for y in 0..5 {
        for x in 0..5 {
            if has(p, y, x) {
                turned[x] = turned[x] | (1 << (4 - (h - 1 - y)));
            }
        }
    }
    for k in 0..5 { p[k] = turned[k]; }
    normalize(p);
}

fn copy(from: [int], to: [int]) {
    for r in 0..5 { to[r] = from[r]; }
}

// ---- the board -----------------------------------------------------------------

// Does piece p fit with its top-left at column x, row y?
fn fits(p: [int], x: int, y: int) -> bool {
    if x < 0 or x + width(p) > W { return false; }
    for r in 0..5 {
        if p[r] != 0 {
            var row = y + r;
            if row >= H { return false; }
            if row >= 0 and board[row] & ((p[r] << 5) >> x) != 0 { return false; }
        }
    }
    return true;
}

// Put piece p into the board's bits.
fn place(p: [int], x: int, y: int) {
    for r in 0..5 {
        if p[r] != 0 and y + r >= 0 {
            board[y + r] = board[y + r] | ((p[r] << 5) >> x);
        }
    }
}

fn new_target() {
    target = 1 + random_below(FULL - 1);
}

// Clear full rows and rows matching the target; returns how many cleared.
fn clear_rows() -> int {
    var full = 0;
    var bonus = 0;
    var r = H - 1;
    while r >= 0 {
        var v = board[r];
        if v == FULL or v == target {
            if v == FULL {
                full = full + 1;
            } else {
                bonus = bonus + 1;
                new_target();
            }
            var k = r;
            while k > 0 {
                board[k] = board[k - 1];
                k = k - 1;
            }
            board[0] = 0;
        } else {
            r = r - 1;
        }
    }
    lines = lines + full + bonus;
    score = score + (full * 10 + bonus * 50) * level;
    level = 1 + lines / 10;
    return full + bonus;
}

// The next piece starts at the top; false if it doesn't fit (game over).
fn spawn() -> bool {
    copy(next, piece);
    grow(next);
    px = (W - width(piece)) / 2;
    py = 0;
    return fits(piece, px, py);
}

// Frames between steps down.
fn delay() -> int {
    return max(6, 33 - 3 * level);
}

// ---- drawing -----------------------------------------------------------------------

fn draw_cell(col: int, row: int, on: bool) {
    var x = BOARD_X + col * 4;
    var y = BOARD_Y + row * 4;
    fill_rect(x, y, 4, 4, false);
    if on { fill_rect(x, y, 3, 3, true); }
}

fn draw_piece(on: bool) {
    for r in 0..5 {
        for c in 0..5 {
            if has(piece, r, c) { draw_cell(px + c, py + r, on); }
        }
    }
}

fn draw_board() {
    for r in 0..H {
        var v = board[r];
        for c in 0..W {
            draw_cell(c, r, (v >> (9 - c)) & 1 == 1);
        }
    }
}

fn draw_panel() {
    fill_rect(0, 12, 40, 6, false);
    draw_int(score, 0, 2);
    fill_rect(0, 30, 40, 6, false);
    draw_int(lines, 0, 5);
    fill_rect(0, 48, 40, 6, false);
    draw_int(level, 0, 8);
    // the next piece, in small cells
    fill_rect(92, 14, 20, 20, false);
    for r in 0..5 {
        for c in 0..5 {
            if has(next, r, c) { fill_rect(92 + c * 4, 14 + r * 4, 3, 3, true); }
        }
    }
    // the target, one binary digit per board column
    for b in 0..10 {
        draw_char('0' + ((target >> (9 - b)) & 1), 22 + b, 8);
    }
}

fn draw_all() {
    clear();
    draw_rect(BOARD_X - 2, BOARD_Y - 2, 4 * W + 3, 4 * H + 3);
    draw_text("SCORE", 5, 0, 1);
    draw_text("LINES", 5, 0, 4);
    draw_text("LEVEL", 5, 0, 7);
    draw_text("NEXT", 4, 22, 1);
    draw_text("TARGET", 6, 22, 7);
    draw_board();
    draw_panel();
    draw_piece(true);
}

// ---- moving --------------------------------------------------------------------------

fn try_move(dx: int, dy: int) -> bool {
    if not fits(piece, px + dx, py + dy) { return false; }
    draw_piece(false);
    px = px + dx;
    py = py + dy;
    draw_piece(true);
    return true;
}

fn try_rotate() {
    copy(piece, spare);
    rotate(spare);
    // as it is, or pushed back from a wall
    var shifts: [int] = KICKS;
    for i in 0..5 {
        if fits(spare, px + shifts[i], py) {
            draw_piece(false);
            copy(spare, piece);
            px = px + shifts[i];
            draw_piece(true);
            return;
        }
    }
}

const KICKS = [0, -1, 1, -2, 2];

// The piece can't fall further: lock it, clear rows, start the next one.
fn lock() {
    place(piece, px, py);
    clear_rows();
    if not spawn() { over = true; }
    draw_board();
    draw_panel();
    if not over { draw_piece(true); }
}

// One step down, locking if it can't.
fn fall() {
    if not try_move(0, 1) { lock(); }
}

fn drop() {
    draw_piece(false);
    while fits(piece, px, py + 1) { py = py + 1; }
    lock();
}

// ---- the game ----------------------------------------------------------------------

fn new_game() {
    for r in 0..H { board[r] = 0; }
    score = 0;
    lines = 0;
    level = 1;
    over = false;
    new_target();
    grow(next);
    spawn();
}

fn play() {
    new_game();
    draw_all();
    var last = 0;
    var due = ticks() + delay();
    var repeat_at = 0;
    while not over {
        var k = key();
        if k != last {
            if k == LEFT { try_move(-1, 0); }
            else if k == RIGHT { try_move(1, 0); }
            else if k == UP { try_rotate(); }
            else if k == ' ' { drop(); due = ticks() + delay(); }
            else if k == DOWN { fall(); repeat_at = ticks() + 4; }
            last = k;
        } else if k == DOWN and ticks() - repeat_at >= 0 {
            fall();
            repeat_at = ticks() + 3;
        }
        if not over and ticks() - due >= 0 {
            fall();
            due = ticks() + delay();
        }
    }
}

fn title() {
    clear();
    draw_rect(20, 20, 88, 56);
    draw_text("BITFALL", 7, 12, 5);
    draw_text("PRESS A KEY", 11, 10, 8);
    wait_key();
}

fn game_over() {
    fill_rect(28, 36, 72, 20, false);
    draw_rect(28, 36, 72, 20);
    draw_text("GAME OVER", 9, 11, 7);
    wait(60);
    wait_key();
}

// ---- main ----

fn main() {
    while true {
        title();
        play();
        game_over();
    }
}
